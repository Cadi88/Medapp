# Solo para desarrollo local. Nunca usar estos valores fuera de la máquina del desarrollador.
POSTGRES_PASSWORD=postgres_local_dev
IDENTIDAD_MIGRATOR_PASSWORD=identidad_migrator_local_dev
IDENTIDAD_APP_PASSWORD=identidad_app_local_dev
AUDITORIA_MIGRATOR_PASSWORD=auditoria_migrator_local_dev
AUDITORIA_APP_PASSWORD=auditoria_app_local_dev
AGENDA_MIGRATOR_PASSWORD=agenda_migrator_local_dev
AGENDA_APP_PASSWORD=agenda_app_local_dev
MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_dev_pw

# Perfil `app` (generados por scripts/generar-dev-env.sh): BETTER_AUTH_SECRET y JWT_PRIVATE_JWK.
# BETTER_AUTH_URL=http://localhost:8080   # origen público de la API (por defecto el gateway)
# WEB_ORIGEN=http://localhost:3000   # origen publico del sitio web: `web` lo envia como Origin a Better Auth
# ORIGENES_CONFIABLES=http://localhost:3000   # solo svc-identidad (coma-separado); en compose se deriva de WEB_ORIGEN
