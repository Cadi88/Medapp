# Imagen del sitio web (Next.js, salida standalone). Uso: docker build -f docker/Dockerfile.web .
ARG NODE_IMAGE=node:24-slim

# 1) Poda del monorepo: solo apps/web y sus paquetes (mejor caché de capas).
FROM ${NODE_IMAGE} AS podador
RUN npm install -g turbo@^2.11.10
WORKDIR /repo
COPY . .
RUN turbo prune @consultorio/web --docker

# 2) Instalación con lockfile congelado y compilación (paquetes del workspace primero, luego `next build`).
FROM ${NODE_IMAGE} AS constructor
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
WORKDIR /repo
COPY --from=podador /repo/out/json/ .
COPY --from=podador /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=podador /repo/out/full/ .
# turbo prune no incluye los archivos de la raíz que no son de un paquete.
COPY tsconfig.base.json ./
RUN pnpm --filter "@consultorio/web..." run build

# 3) Runtime mínimo y sin root: el servidor standalone ya trae solo las dependencias que traza Next.
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
# Docker fija HOSTNAME al id del contenedor; el servidor de Next escucha en esa dirección.
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=constructor --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=constructor --chown=node:node /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=constructor --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=12 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/login').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]
