{
  "name": "@consultorio/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@consultorio/platform": "workspace:*",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
