{
  "name": "@consultorio/svc-agenda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@consultorio/contracts": "workspace:*",
    "@consultorio/platform": "workspace:*",
    "@nats-io/transport-node": "^3.4.0",
    "fastify": "^5.12.8",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "luxon": "^3.7.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@nats-io/jetstream": "^3.4.0"
  }
}
